Algoritmo tres_intervalos
	
	Definir x, min1, max1, min2, max2, min3, max3 Como Entero
	
	Escribir "Ingrese el número x:"
	Leer x
	
	Escribir "Ingrese el mínimo del intervalo 1:"
	Leer min1
	
	Escribir "Ingrese el máximo del intervalo 1:"
	Leer max1
	
	Escribir "Ingrese el mínimo del intervalo 2:"
	Leer min2
	
	Escribir "Ingrese el máximo del intervalo 2:"
	Leer max2
	
	Escribir "Ingrese el mínimo del intervalo 3:"
	Leer min3
	
	Escribir "Ingrese el máximo del intervalo 3:"
	Leer max3
	
	Si (x > min1 Y x < max1) O (x > min2 Y x < max2) O (x > min3 Y x < max3) Entonces
		Escribir x, " está DENTRO de uno de los intervalos"
	SiNo
		Escribir x, " está FUERA de todos los intervalos"
	FinSi
	
FinAlgoritmo